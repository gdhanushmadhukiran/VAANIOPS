# Gnani API Credentials (Required for Prisma STT and Timbre TTS)
GNANI_API_KEY=
DATABASE_URL=sqlite:///./vaaniops.db
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development
GNANI_TIMEOUT_SECONDS=60

# Gnani Evon v3.3 Intelligence Configuration (Hosted vLLM GPU Server)
# Keep EVON_ENABLED=false until a dedicated GPU inference host is deployed.
EVON_ENABLED=false
EVON_BASE_URL=https://api.vachana.ai/v1
EVON_MODEL=model
EVON_API_KEY=
EVON_TIMEOUT_SECONDS=30
